# ROCm 6.4.3 supports gfx908 and the MI100 observed on the AMD node.
FROM rocm/dev-ubuntu-22.04:6.4.3@sha256:09965ffc0f15be19637dabd818320687c7bb9aa7ea7ab57c1d2f1f388f8e7c05

ARG PAPI_VERSION=7.2.0
ARG PAPI_SHA256=a9bff89ccf39915d729e08ae0a0c6a71ce0ebbe98411e9a2eb3c83c8db0af39c

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV ROCM_PATH=/opt/rocm
ENV PAPI_ROCP_SDK_ROOT=/opt/rocm
ENV PATH=/opt/rocm/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/lib:/opt/rocm/lib:/opt/rocm/lib64

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    libpfm4-dev \
    pkg-config \
    wget \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSLo /tmp/papi-${PAPI_VERSION}.tar.gz \
        "https://icl.utk.edu/projects/papi/downloads/papi-${PAPI_VERSION}.tar.gz" && \
    echo "${PAPI_SHA256}  /tmp/papi-${PAPI_VERSION}.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/papi-${PAPI_VERSION}.tar.gz -C /tmp && \
    cd /tmp/papi-${PAPI_VERSION}/src && \
    ./configure --prefix=/usr/local \
        --with-components=rocp_sdk \
        --with-rocm="${ROCM_PATH}" \
        --with-rocm-include="${ROCM_PATH}/include" \
        --with-rocm-lib="${ROCM_PATH}/lib" && \
    make -j"$(nproc)" && \
    make -j"$(nproc)" utils && \
    make install && \
    ldconfig && \
    rm -rf /tmp/papi-${PAPI_VERSION} /tmp/papi-${PAPI_VERSION}.tar.gz

WORKDIR /workspace
CMD ["/bin/bash"]
